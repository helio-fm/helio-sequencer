{
    "folders":
    [
        {
            "path": "../../Resources"
        },
        {
            "path": "../../Source"
        },
        {
            "name": "JUCE",
            "path": "../../ThirdParty/JUCE/modules"
        }
    ],
    "settings":
    {
        "tab_size": 4,
        "default_line_ending": "unix",
        "translate_tabs_to_spaces": true,
        "draw_white_space": ["isolated", "selection"]
    },
    "build_systems":
    [
        {
            "name": "Build & Run",
            "selector": "source.c++, source.c, source.json",
            "word_wrap": false,
            "quiet": true,
            "variants":
            [
                {
                    "name": "Debug",
                    "windows":
                    {
                        "working_dir": "${project_path}/../VisualStudio2019",
                        "shell_cmd": "for /f \"usebackq delims=\" %i in (`\"%ProgramFiles(x86)%\\Microsoft Visual Studio\\Installer\\vswhere.exe\" -property installationpath`) do call \"%i\\VC\\Auxiliary\\Build\\vcvarsall.bat\" x64 > NUL && \"%i\\MSBuild\\Current\\Bin\\MSBuild.exe\" Helio.sln /t:Build /p:Configuration=Debug;Platform=x64 /verbosity:minimal && x64\\Debug\\App\\Helio.exe && goto :eof",
                        "file_regex": "^\\s*(.+?)\\(([0-9]+),?([0-9]+)?\\):\\s*(.*) \\[",
                        "encoding": "cp866"
                    },
                    "linux":
                    {
                        "working_dir": "${project_path}/../LinuxMakefile",
                        "shell_cmd": "CONFIG=Debug make all && ./build/helio"
                    }
                },
                {
                    "name": "Debug with CDB", // slow af
                    "windows":
                    {
                        "working_dir": "${project_path}/../VisualStudio2019",
                        "shell_cmd": "for /f \"usebackq delims=\" %i in (`\"%ProgramFiles(x86)%\\Microsoft Visual Studio\\Installer\\vswhere.exe\" -property installationpath`) do call \"%i\\VC\\Auxiliary\\Build\\vcvarsall.bat\" x64 > NUL && \"%i\\MSBuild\\Current\\Bin\\MSBuild.exe\" Helio.sln /t:Build /p:Configuration=Debug;Platform=x64 /verbosity:minimal && \"%ProgramFiles(x86)%\\Windows Kits\\10\\Debuggers\\x64\\cdb.exe\" -g -G x64\\Debug\\App\\Helio.exe && goto :eof",
                        "file_regex": "^\\s*(.+?)\\(([0-9]+),?([0-9]+)?\\):\\s*(.*) \\[",
                        "encoding": "cp866"
                    }
                },
                {
                    "name": "Release",
                    "windows":
                    {
                        "working_dir": "${project_path}/../VisualStudio2019",
                        "shell_cmd": "for /f \"usebackq delims=\" %i in (`\"%ProgramFiles(x86)%\\Microsoft Visual Studio\\Installer\\vswhere.exe\" -property installationpath`) do call \"%i\\VC\\Auxiliary\\Build\\vcvarsall.bat\" x64 > NUL && del x64\\Release64\\App\\Helio.exe && \"%i\\MSBuild\\Current\\Bin\\MSBuild.exe\" Helio.sln /t:Build /p:Configuration=Release64;Platform=x64 /verbosity:minimal && x64\\Release64\\App\\Helio.exe && goto :eof",
                        "file_regex": "^\\s*(.+?)\\(([0-9]+),?([0-9]+)?\\):\\s*(.*) \\[",
                        "encoding": "cp866"
                    },
                    "linux":
                    {
                        "working_dir": "${project_path}/../LinuxMakefile",
                        "shell_cmd": "CONFIG=Release64 make clean all && ./build/helio"
                    }
                },
                {
                    "name": "Tests",
                    "windows":
                    {
                        "working_dir": "${project_path}/../VisualStudio2019",
                        "shell_cmd": "for /f \"usebackq delims=\" %i in (`\"%ProgramFiles(x86)%\\Microsoft Visual Studio\\Installer\\vswhere.exe\" -property installationpath`) do call \"%i\\VC\\Auxiliary\\Build\\vcvarsall.bat\" x64 > NUL && \"%i\\MSBuild\\Current\\Bin\\MSBuild.exe\" Helio.sln /t:Build /p:Configuration=Tests;Platform=x64 /verbosity:minimal && x64\\Tests\\App\\Helio.exe && goto :eof",
                        "file_regex": "^\\s*(.+?)\\(([0-9]+),?([0-9]+)?\\):\\s*(.*) \\[",
                        "encoding": "cp866"
                    },
                    "linux":
                    {
                        "working_dir": "${project_path}/../LinuxMakefile",
                        "shell_cmd": "CONFIG=Tests make all && ./build/helio"
                    }
                },
            ]
        }
    ]
}